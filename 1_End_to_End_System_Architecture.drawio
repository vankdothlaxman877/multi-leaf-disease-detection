<mxfile host="app.diagrams.net" modified="2026-11-16T15:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="academic_overview" name="System Architecture (Academic Style)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Multi-Leaf Disease Detection Pipeline: System Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1450" height="40" as="geometry" />
        </mxCell>

        <!-- CONTAINER 1: DATASETS -->
        <mxCell id="box_data" value="Decentralized Agricultural Datasets" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;dashed=1;fontColor=#000000;fontFamily=Helvetica;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="90" width="400" height="420" as="geometry" />
        </mxCell>

        <mxCell id="d_mango" value="&lt;b&gt;Client Node 1: Mango Leaf&lt;/b&gt;&lt;br/&gt;• Healthy: 340 images&lt;br/&gt;• Diseased: 530 images&lt;br/&gt;• Total: 870 images&lt;br/&gt;• Binary Label (0: Healthy, 1: Diseased)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="125" y="140" width="350" height="90" as="geometry" />
        </mxCell>

        <mxCell id="d_apple" value="&lt;b&gt;Client Node 2: Apple Leaf&lt;/b&gt;&lt;br/&gt;• Healthy: 1,032 images&lt;br/&gt;• Diseased: 2,428 images (Rust, Scab)&lt;br/&gt;• Total: 3,460 images&lt;br/&gt;• Binary Label (0: Healthy, 1: Diseased)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="125" y="255" width="350" height="90" as="geometry" />
        </mxCell>

        <mxCell id="d_tomato" value="&lt;b&gt;Client Node 3: Tomato Leaf&lt;/b&gt;&lt;br/&gt;• Healthy: 2,000 images&lt;br/&gt;• Diseased: 17,999 images (9 pathology classes)&lt;br/&gt;• Total: 19,999 images (Capped at 1,500/class)&lt;br/&gt;• Binary Label (0: Healthy, 1: Diseased)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="125" y="370" width="350" height="110" as="geometry" />
        </mxCell>

        <!-- CONTAINER 2: PREPROCESSING -->
        <mxCell id="box_prep" value="Image Preprocessing Pipeline" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;dashed=1;fontColor=#000000;fontFamily=Helvetica;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="90" width="410" height="420" as="geometry" />
        </mxCell>

        <mxCell id="p_resize" value="&lt;b&gt;1. Spatial Resizing&lt;/b&gt;&lt;br/&gt;Standardize to 224 × 224 × 3 pixels" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="570" y="140" width="350" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p_clahe" value="&lt;b&gt;2. CLAHE Contrast Enhancement&lt;/b&gt;&lt;br/&gt;LAB space conversion; L-channel equalization&lt;br/&gt;Clip Limit = 2.0, Grid Size = 8 × 8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="570" y="230" width="350" height="75" as="geometry" />
        </mxCell>

        <mxCell id="p_tvf" value="&lt;b&gt;3. Total Variation Filter (TVF)&lt;/b&gt;&lt;br/&gt;Chambolle Denoising (weight=0.1, n_iter=100)&lt;br/&gt;Edge-preserving artifact suppression" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="570" y="325" width="350" height="75" as="geometry" />
        </mxCell>

        <mxCell id="p_vmd" value="&lt;b&gt;4. Variational Mode Decomposition (VMD)&lt;/b&gt;&lt;br/&gt;Decomposition into K=4 sub-band intrinsic modes&lt;br/&gt;Isolates low-frequency shape &amp; high-frequency lesion textures" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="570" y="420" width="350" height="75" as="geometry" />
        </mxCell>

        <!-- CONTAINER 3: FEATURE EXTRACTION -->
        <mxCell id="box_feat" value="Ensemble Deep Feature Extraction" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;dashed=1;fontColor=#000000;fontFamily=Helvetica;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="90" width="560" height="420" as="geometry" />
        </mxCell>

        <mxCell id="f_vgg" value="&lt;b&gt;Backbone 1: VGG19 (ImageNet Pre-trained)&lt;/b&gt;&lt;br/&gt;Global Average Pooling Output: &lt;b&gt;512 dimensions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1020" y="140" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f_dense" value="&lt;b&gt;Backbone 2: DenseNet121 (ImageNet Pre-trained)&lt;/b&gt;&lt;br/&gt;Global Average Pooling Output: &lt;b&gt;1,024 dimensions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1020" y="230" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f_res" value="&lt;b&gt;Backbone 3: ResNet50 (ImageNet Pre-trained)&lt;/b&gt;&lt;br/&gt;Global Average Pooling Output: &lt;b&gt;2,048 dimensions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1020" y="320" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f_concat" value="&lt;b&gt;Feature Concatenation Layer&lt;/b&gt;&lt;br/&gt;Combined Feature Vector: 512 + 1024 + 2048 = &lt;b&gt;3,584 Dimensions&lt;/b&gt;&lt;br/&gt;Dense multi-level spatial representation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=12;fontColor=#000000;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="1020" y="415" width="500" height="80" as="geometry" />
        </mxCell>

        <!-- CONTAINER 4: FEDERATED LEARNING -->
        <mxCell id="box_fl" value="Decentralized Federated Learning &amp; Global Evaluation" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;dashed=1;fontColor=#000000;fontFamily=Helvetica;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="1450" height="420" as="geometry" />
        </mxCell>

        <mxCell id="fl_c1" value="&lt;b&gt;Client Node 1 (Mango)&lt;/b&gt;&lt;br/&gt;• Dataset D₁ (N₁ = 870)&lt;br/&gt;• Local SGD: 8 Epochs&lt;br/&gt;• Weight Update: W₁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="130" y="610" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fl_c2" value="&lt;b&gt;Client Node 2 (Apple)&lt;/b&gt;&lt;br/&gt;• Dataset D₂ (N₂ = 3,460)&lt;br/&gt;• Local SGD: 8 Epochs&lt;br/&gt;• Weight Update: W₂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="130" y="720" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fl_c3" value="&lt;b&gt;Client Node 3 (Tomato)&lt;/b&gt;&lt;br/&gt;• Dataset D₃ (N₃ = 19,999)&lt;br/&gt;• Local SGD: 8 Epochs&lt;br/&gt;• Weight Update: W₃" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="130" y="830" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fl_srv" value="&lt;b&gt;Central Server Aggregation (FedAvg)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;W_(t+1) = Σ (n_k / N) · W_k^(t+1)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• 15 Communication Rounds&lt;br/&gt;• Weight updates aggregated by sample size weighting&lt;br/&gt;• Global weights broadcast back to local clients&lt;br/&gt;• No raw data leaves edge devices (Privacy-Preserving)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=12;fontColor=#000000;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="630" width="460" height="260" as="geometry" />
        </mxCell>

        <mxCell id="fl_res" value="&lt;b&gt;Experimental Validation &amp; Metrics&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;10-Fold Stratified Cross-Validation&lt;/b&gt;&lt;br/&gt;  - Mean Accuracy: &lt;b&gt;98.2% ± 0.6%&lt;/b&gt;&lt;br/&gt;  - Mean Sensitivity: &lt;b&gt;97.9% ± 0.8%&lt;/b&gt;&lt;br/&gt;  - Mean Specificity: &lt;b&gt;98.8% ± 0.4%&lt;/b&gt;&lt;br/&gt;  - Area Under Curve (AUC): &lt;b&gt;0.9984&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Wilcoxon Signed-Rank Test&lt;/b&gt;: p &lt; 0.05&lt;br/&gt;  (Statistically significant performance gain)&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Model File&lt;/b&gt;: global_federated_leaf_disease_model.keras" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="1010" y="630" width="510" height="260" as="geometry" />
        </mxCell>

        <!-- ARROWS -->
        <mxCell id="arr_1" edge="1" parent="1" source="box_data" target="box_prep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="arr_2" edge="1" parent="1" source="box_prep" target="box_feat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        
        <mxCell id="arr_u1" value="W₁" edge="1" parent="1" source="fl_c1" target="fl_srv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="arr_u2" value="W₂" edge="1" parent="1" source="fl_c2" target="fl_srv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="arr_u3" value="W₃" edge="1" parent="1" source="fl_c3" target="fl_srv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />

        <mxCell id="arr_res" value="Validated Global Weights" edge="1" parent="1" source="fl_srv" target="fl_res" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />

      </root>
    </mxGraphModel>
  </diagram>
