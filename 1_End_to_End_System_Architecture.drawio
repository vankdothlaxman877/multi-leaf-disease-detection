<mxfile host="app.diagrams.net" modified="2026-11-16T15:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="diag_overview" name="1. End-to-End System Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Header -->
        <mxCell id="header" value="MULTI-LEAF DISEASE DETECTION: COMPLETE SYSTEM ARCHITECTURE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=20;fontStyle=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1450" height="50" as="geometry" />
        </mxCell>

        <!-- STAGE 1: DATASETS -->
        <mxCell id="grp_datasets" value="STAGE 1: MULTI-CROP LEAF DATASETS (Decentralized Clients)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=2;dashed=1;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="420" height="420" as="geometry" />
        </mxCell>

        <mxCell id="ds_mango" value="&lt;b&gt;Client 1: Mango Leaves&lt;/b&gt;&lt;br/&gt;• Healthy: 340 images&lt;br/&gt;• Diseased: 530 images&lt;br/&gt;&lt;i&gt;Total: 870 images&lt;/i&gt;&lt;br/&gt;Binary Split (0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="160" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ds_apple" value="&lt;b&gt;Client 2: Apple Leaves&lt;/b&gt;&lt;br/&gt;• Healthy: 1,032 images&lt;br/&gt;• Diseased (Rust &amp; Scab): 2,428 images&lt;br/&gt;&lt;i&gt;Total: 3,460 images&lt;/i&gt;&lt;br/&gt;Binary Split (0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="270" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ds_tomato" value="&lt;b&gt;Client 3: Tomato Leaves&lt;/b&gt;&lt;br/&gt;• Healthy: 2,000 images&lt;br/&gt;• Diseased (9 Disease Classes): 17,999 images&lt;br/&gt;&lt;i&gt;Total: 19,999 images (Capped at 1,500/class)&lt;/i&gt;&lt;br/&gt;Binary Split (0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="380" width="360" height="110" as="geometry" />
        </mxCell>

        <!-- STAGE 2: PREPROCESSING -->
        <mxCell id="grp_preproc" value="STAGE 2: PREPROCESSING PIPELINE (Per Image)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=2;dashed=1;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="110" width="400" height="420" as="geometry" />
        </mxCell>

        <mxCell id="pre_resize" value="&lt;b&gt;1. Resize &amp; Color Space Conversion&lt;/b&gt;&lt;br/&gt;Input shape: 224 x 224 x 3&lt;br/&gt;BGR → LAB Color Space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#06B6D4;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="pre_clahe" value="&lt;b&gt;2. CLAHE (Contrast-Limited AHE)&lt;/b&gt;&lt;br/&gt;Enhance L-channel (clipLimit=2.0, grid=8x8)&lt;br/&gt;Highlights sharp lesion borders under low light" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#06B6D4;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="pre_tvf" value="&lt;b&gt;3. TVF (Total Variation Filter)&lt;/b&gt;&lt;br/&gt;Chambolle Denoising (weight=0.1, iters=100)&lt;br/&gt;Removes background noise, preserves edge gradients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#06B6D4;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="345" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="pre_vmd" value="&lt;b&gt;4. VMD (Variational Mode Decomposition)&lt;/b&gt;&lt;br/&gt;K=4 Sub-band Intrinsic Modes (VM1, VM2, VM3, VM4)&lt;br/&gt;Extracts multi-frequency pathological textures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#06B6D4;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="440" width="340" height="75" as="geometry" />
        </mxCell>

        <!-- STAGE 3: FEATURE EXTRACTION -->
        <mxCell id="grp_feat" value="STAGE 3: DEEP ENSEMBLE FEATURE EXTRACTION" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;dashed=1;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1020" y="110" width="530" height="420" as="geometry" />
        </mxCell>

        <mxCell id="feat_vgg" value="&lt;b&gt;Backbone 1: VGG19 (ImageNet Pre-trained)&lt;/b&gt;&lt;br/&gt;Pooling: GlobalAveragePooling2D&lt;br/&gt;&lt;font color='#7E22CE'&gt;&lt;b&gt;Output: 512-dimensional vector&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="160" width="470" height="70" as="geometry" />
        </mxCell>

        <mxCell id="feat_dense" value="&lt;b&gt;Backbone 2: DenseNet121 (ImageNet Pre-trained)&lt;/b&gt;&lt;br/&gt;Dense feature reuse, high gradient flow&lt;br/&gt;&lt;font color='#7E22CE'&gt;&lt;b&gt;Output: 1,024-dimensional vector&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="250" width="470" height="70" as="geometry" />
        </mxCell>

        <mxCell id="feat_res" value="&lt;b&gt;Backbone 3: ResNet50 (ImageNet Pre-trained)&lt;/b&gt;&lt;br/&gt;Deep residual skip connections&lt;br/&gt;&lt;font color='#7E22CE'&gt;&lt;b&gt;Output: 2,048-dimensional vector&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="340" width="470" height="70" as="geometry" />
        </mxCell>

        <mxCell id="feat_concat" value="&lt;b&gt;Concatenated Ensemble Representation&lt;/b&gt;&lt;br/&gt;512 + 1024 + 2048 = &lt;font color='#7E22CE'&gt;&lt;b&gt;3,584-Dimensional Feature Vector&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;Combines fine textures, dense semantic patterns &amp; deep context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDD6FE;strokeColor=#6D28D9;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="430" width="470" height="80" as="geometry" />
        </mxCell>

        <!-- STAGE 4: FEDERATED LEARNING & EVALUATION -->
        <mxCell id="grp_fl" value="STAGE 4: FEDERATED LEARNING (FedAvg) &amp; CLINICAL EVALUATION" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=2;dashed=1;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="580" width="1450" height="420" as="geometry" />
        </mxCell>

        <!-- Clients Boxes -->
        <mxCell id="fl_client1" value="&lt;b&gt;Node 1: Mango Client&lt;/b&gt;&lt;br/&gt;Local Dataset D₁ (N₁=870)&lt;br/&gt;Local Training (8 Epochs)&lt;br/&gt;Weights Update: &lt;i&gt;W₁&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="640" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fl_client2" value="&lt;b&gt;Node 2: Apple Client&lt;/b&gt;&lt;br/&gt;Local Dataset D₂ (N₂=3460)&lt;br/&gt;Local Training (8 Epochs)&lt;br/&gt;Weights Update: &lt;i&gt;W₂&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="750" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fl_client3" value="&lt;b&gt;Node 3: Tomato Client&lt;/b&gt;&lt;br/&gt;Local Dataset D₃ (N₃=19999)&lt;br/&gt;Local Training (8 Epochs)&lt;br/&gt;Weights Update: &lt;i&gt;W₃&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="860" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Central FL Server -->
        <mxCell id="fl_server" value="&lt;b&gt;CENTRAL FEDERATED AGGREGATOR (FedAvg)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color='#1E40AF'&gt;&lt;b&gt;W_(t+1) = Σ (n_k / N) * W_k&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Coordinates 15 Global Communication Rounds&lt;br/&gt;• Aggregates weight updates weighted by client size&lt;br/&gt;• Distributes updated global weights back to all nodes&lt;br/&gt;• &lt;b&gt;Zero raw data transfer (100% Privacy Preserving)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="660" width="420" height="260" as="geometry" />
        </mxCell>

        <!-- Evaluation Results Box -->
        <mxCell id="fl_eval" value="&lt;b&gt;EVALUATION &amp; STATISTICAL RIGOR&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;10-Fold Stratified Cross-Validation&lt;/b&gt;&lt;br/&gt;  - Accuracy: &lt;font color='#059669'&gt;&lt;b&gt;98.2% ± 0.6%&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;  - Sensitivity: &lt;font color='#059669'&gt;&lt;b&gt;97.9% ± 0.8%&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;  - Specificity: &lt;font color='#059669'&gt;&lt;b&gt;98.8% ± 0.4%&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;  - Area Under Curve (AUC): &lt;font color='#059669'&gt;&lt;b&gt;0.9984&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Wilcoxon Signed-Rank Test&lt;/b&gt;: p &lt; 0.05&lt;br/&gt;  (Proves FL model significantly beats local models)&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Saved Model&lt;/b&gt;: global_federated_leaf_disease_model.keras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="660" width="450" height="260" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="c1" edge="1" parent="1" source="grp_datasets" target="grp_preproc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#0284C7;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c2" edge="1" parent="1" source="grp_preproc" target="grp_feat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#7C3AED;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c3" edge="1" parent="1" source="feat_concat" target="fl_client2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#4B5563;dashed=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1285" y="550" />
              <mxPoint x="290" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="c_up1" value="Upload W₁" edge="1" parent="1" source="fl_client1" target="fl_server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563EB;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c_up2" value="Upload W₂" edge="1" parent="1" source="fl_client2" target="fl_server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563EB;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c_up3" value="Upload W₃" edge="1" parent="1" source="fl_client3" target="fl_server" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563EB;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c_eval" value="Final Aggregated Model" edge="1" parent="1" source="fl_server" target="fl_eval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#059669;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
