<mxfile host="app.diagrams.net" modified="2026-11-16T15:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="academic_preproc" name="Preprocessing & Feature Extraction">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t2" value="Image Preprocessing and Multi-Backbone Feature Extraction Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1340" height="40" as="geometry" />
        </mxCell>

        <!-- Pipeline Sequence -->
        <mxCell id="s_raw" value="&lt;b&gt;Raw Image Input&lt;/b&gt;&lt;br/&gt;Three-channel RGB/BGR&lt;br/&gt;Variable field conditions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s_res" value="&lt;b&gt;1. Bilinear Interpolation&lt;/b&gt;&lt;br/&gt;Resolution: 224 × 224 × 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s_clahe" value="&lt;b&gt;2. CLAHE Filter&lt;/b&gt;&lt;br/&gt;RGB → LAB space&lt;br/&gt;L-channel histogram equalization&lt;br/&gt;Clip Limit = 2.0, Grid = 8 × 8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590" y="130" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s_tvf" value="&lt;b&gt;3. Total Variation Filter&lt;/b&gt;&lt;br/&gt;Chambolle optimization&lt;br/&gt;Regularization weight = 0.1&lt;br/&gt;Edge-preserving denoising" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="890" y="130" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s_vmd" value="&lt;b&gt;4. VMD Decomposition&lt;/b&gt;&lt;br/&gt;K=4 Sub-band modes&lt;br/&gt;VM1–VM4 signal textures&lt;br/&gt;Spectral mode isolation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1190" y="130" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="a_1" edge="1" parent="1" source="s_raw" target="s_res" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="a_2" edge="1" parent="1" source="s_res" target="s_clahe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="a_3" edge="1" parent="1" source="s_clahe" target="s_tvf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="a_4" edge="1" parent="1" source="s_tvf" target="s_vmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />

        <!-- Deep Backbones Frame -->
        <mxCell id="bb_frame" value="Deep Convolutional Feature Extractors (Pretrained ImageNet Weights)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.5;dashed=1;fontColor=#000000;fontFamily=Helvetica;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="1340" height="330" as="geometry" />
        </mxCell>

        <mxCell id="m_vgg" value="&lt;b&gt;VGG19 Feature Backbone&lt;/b&gt;&lt;br/&gt;16 Convolutional Layers + MaxPool&lt;br/&gt;Global Average Pooling&lt;br/&gt;&lt;b&gt;Output Vector: 512-dim&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="150" y="330" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m_dense" value="&lt;b&gt;DenseNet121 Feature Backbone&lt;/b&gt;&lt;br/&gt;Dense connectivity blocks with feature reuse&lt;br/&gt;Global Average Pooling&lt;br/&gt;&lt;b&gt;Output Vector: 1,024-dim&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="340" height="100" as="geometry" />
        </mxCell>

        <mxCell id="m_res" value="&lt;b&gt;ResNet50 Feature Backbone&lt;/b&gt;&lt;br/&gt;Deep bottleneck residual identity shortcuts&lt;br/&gt;Global Average Pooling&lt;br/&gt;&lt;b&gt;Output Vector: 2,048-dim&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1030" y="330" width="330" height="100" as="geometry" />
        </mxCell>

        <!-- Concatenation -->
        <mxCell id="concat_box" value="&lt;b&gt;Feature Concatenation Layer&lt;/b&gt;&lt;br/&gt;[ VGG19 (512) ⊕ DenseNet121 (1024) ⊕ ResNet50 (2048) ]&lt;br/&gt;&lt;b&gt;Unified 3,584-Dimensional Feature Representation&lt;/b&gt;&lt;br/&gt;Transferred to Federated Classification Network" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=12;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="480" width="1000" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b_1" edge="1" parent="1" source="s_vmd" target="m_vgg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1305" y="240" />
              <mxPoint x="310" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b_2" edge="1" parent="1" source="s_vmd" target="m_dense" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1305" y="240" />
              <mxPoint x="750" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b_3" edge="1" parent="1" source="s_vmd" target="m_res" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1305" y="240" />
              <mxPoint x="1195" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="cv1" edge="1" parent="1" source="m_vgg" target="concat_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="cv2" edge="1" parent="1" source="m_dense" target="concat_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />
        <mxCell id="cv3" edge="1" parent="1" source="m_res" target="concat_box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#000000;endArrow=classic;" />

      </root>
    </mxGraphModel>
