<mxfile host="app.diagrams.net" modified="2026-11-16T15:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="diag_preproc" name="2. Image Preprocessing & Feature Engineering">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header -->
        <mxCell id="h2" value="PREPROCESSING &amp; ENSEMBLE FEATURE EXTRACTION PIPELINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1340" height="50" as="geometry" />
        </mxCell>

        <!-- Raw Image Input -->
        <mxCell id="raw_img" value="&lt;b&gt;Raw Leaf Image&lt;/b&gt;&lt;br/&gt;BGR Format&lt;br/&gt;Any resolution&lt;br/&gt;Noisy / Non-uniform light" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Resize -->
        <mxCell id="resize_step" value="&lt;b&gt;Bilinear Resizing&lt;/b&gt;&lt;br/&gt;Standardized shape:&lt;br/&gt;&lt;font color='#2563EB'&gt;&lt;b&gt;224 x 224 x 3&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- LAB & CLAHE -->
        <mxCell id="clahe_step" value="&lt;b&gt;CLAHE Equalization&lt;/b&gt;&lt;br/&gt;1. Convert BGR → LAB&lt;br/&gt;2. Apply CLAHE on L-channel&lt;br/&gt;3. Re-merge (clipLimit=2.0, grid=8x8)&lt;br/&gt;Enhances subtle disease spots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="140" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- TVF Denoising -->
        <mxCell id="tvf_step" value="&lt;b&gt;Total Variation Filter (TVF)&lt;/b&gt;&lt;br/&gt;Chambolle Algorithm&lt;br/&gt;Weight=0.1, Max Iters=100&lt;br/&gt;Removes camera/sensor noise&lt;br/&gt;Preserves lesion boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="140" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- VMD Decomposition -->
        <mxCell id="vmd_step" value="&lt;b&gt;VMD (K=4 Sub-Bands)&lt;/b&gt;&lt;br/&gt;Variational Mode Decomposition&lt;br/&gt;VM1: Global structural pattern&lt;br/&gt;VM2: Vein morphology&lt;br/&gt;VM3: Lesion margin textures&lt;br/&gt;VM4: High-frequency fungal spots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="140" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- Arrows for Top Pipeline -->
        <mxCell id="a1" edge="1" parent="1" source="raw_img" target="resize_step" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#475569;" />
        <mxCell id="a2" edge="1" parent="1" source="resize_step" target="clahe_step" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#0284C7;" />
        <mxCell id="a3" edge="1" parent="1" source="clahe_step" target="tvf_step" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#0284C7;" />
        <mxCell id="a4" edge="1" parent="1" source="tvf_step" target="vmd_step" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#0891B2;" />

        <!-- Deep Feature Extraction Branching -->
        <mxCell id="bb_title" value="PARALLEL DEEP CNN FEATURE EXTRACTION" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;dashed=1;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="1340" height="340" as="geometry" />
        </mxCell>

        <mxCell id="m_vgg" value="&lt;b&gt;VGG-19&lt;/b&gt;&lt;br/&gt;16 Conv + 3 FC layers&lt;br/&gt;Top Removed + GlobalAvgPool&lt;br/&gt;&lt;font color='#7E22CE'&gt;&lt;b&gt;Output: 512 dimensions&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;Focus: Low &amp; Mid-level edges" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="380" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m_dense" value="&lt;b&gt;DenseNet-121&lt;/b&gt;&lt;br/&gt;Direct connections between layers&lt;br/&gt;Top Removed + GlobalAvgPool&lt;br/&gt;&lt;font color='#7E22CE'&gt;&lt;b&gt;Output: 1,024 dimensions&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;Focus: Collective feature reuse &amp; veins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="380" width="340" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m_res" value="&lt;b&gt;ResNet-50&lt;/b&gt;&lt;br/&gt;Deep residual skip identity blocks&lt;br/&gt;Top Removed + GlobalAvgPool&lt;br/&gt;&lt;font color='#7E22CE'&gt;&lt;b&gt;Output: 2,048 dimensions&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;Focus: High-level semantic disease patterns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="380" width="340" height="110" as="geometry" />
        </mxCell>

        <!-- Concatenation Block -->
        <mxCell id="final_vec" value="&lt;b&gt;CONCATENATION LAYER&lt;/b&gt;&lt;br/&gt;[ VGG19 (512) ⊕ DenseNet121 (1024) ⊕ ResNet50 (2048) ]&lt;br/&gt;&lt;font size='4' color='#6D28D9'&gt;&lt;b&gt;Comprehensive 3,584-Dimensional Feature Vector&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;Fed into Proposed LightResNet / Local Federated Classifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9D5FF;strokeColor=#6B21A8;strokeWidth=3;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="540" width="1000" height="80" as="geometry" />
        </mxCell>

        <!-- Connections from VMD to Models -->
        <mxCell id="b1" edge="1" parent="1" source="vmd_step" target="m_vgg" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7E22CE;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1305" y="290" />
              <mxPoint x="310" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b2" edge="1" parent="1" source="vmd_step" target="m_dense" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7E22CE;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1305" y="290" />
              <mxPoint x="750" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b3" edge="1" parent="1" source="vmd_step" target="m_res" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#7E22CE;rounded=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1305" y="290" />
              <mxPoint x="1190" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Connect Models to Concat -->
        <mxCell id="c_vgg" edge="1" parent="1" source="m_vgg" target="final_vec" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B21A8;" />
        <mxCell id="c_dense" edge="1" parent="1" source="m_dense" target="final_vec" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B21A8;" />
        <mxCell id="c_res" edge="1" parent="1" source="m_res" target="final_vec" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6B21A8;" />

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
